{
  "title": "Status dos Serviços",
  "server": {
    "host": "0.0.0.0",
    "port": 4300
  },
  "logs": {
    "dir": "./logs",
    "retentionDays": 5
  },
  "maxStartDelay": 30,
  "historyHours": 24,
  "defaults": {
    "method": "GET",
    "timeout": 10,
    "retries": 3,
    "retryDelay": 5,
    "failuresBeforeOutage": 1,
    "slowThresholdMs": null,
    "expectedStatus": null,
    "headers": {}
  },
  "endpoints": [
    {
      "id": "psw-main",
      "name": "Aplicação Principal",
      "url": "https://www.pontosystemweb.com.br/#/autenticacao/login",
      "interval": 120,
      "retries": 2,
      "retryDelay": 3,
      "slowThresholdMs": 1500
    },
    {
      "id": "psw-ponto",
      "name": "PSW Ponto Remoto",
      "url": "https://ponto.pontosystemweb.com.br/#/autenticacao/login",
      "interval": 120,
      "retries": 2,
      "retryDelay": 3,
      "slowThresholdMs": 1500
    },
    {
      "id": "psw-core",
      "name": "Core Service",
      "url": "https://core.pontosystemweb.com.br/api/v1/check/status",
      "interval": 90,
      "retries": 2,
      "retryDelay": 3,
      "slowThresholdMs": 1500
    },
    {
      "id": "psw-timesheet",
      "name": "Timesheet Service",
      "url": "https://timesheet.pontosystemweb.com.br/api/v1/check/status",
      "interval": 90,
      "retries": 2,
      "retryDelay": 3,
      "slowThresholdMs": 1500
    },
    {
      "id": "psw-collector",
      "name": "Collector Service",
      "url": "https://collector.pontosystemweb.com.br/api/v1/check/status",
      "interval": 90,
      "retries": 2,
      "retryDelay": 3,
      "slowThresholdMs": 1500
    },
    {
      "id": "psw-rep-p",
      "name": "REP-P Service",
      "url": "https://rep-p-connector.pontosystemweb.com.br/api/v1/check/rep-p-status",
      "interval": 90,
      "retries": 2,
      "retryDelay": 3,
      "slowThresholdMs": 1500
    },
    {
      "id": "psw-rep-connector",
      "name": "REP-P Connector",
      "url": "https://rep-p-connector.pontosystemweb.com.br/api/v1/check/status",
      "interval": 90,
      "retries": 2,
      "retryDelay": 3,
      "slowThresholdMs": 1500
    },
    {
      "id": "psw-rep-p-report",
      "name": "REP-P Report",
      "url": "https://rep-p-report.pontosystemweb.com.br/api/v1/check/status",
      "interval": 90,
      "retries": 2,
      "retryDelay": 3,
      "slowThresholdMs": 1500
    }
  ]
}
